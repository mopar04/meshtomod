# Production web: build the static app, then serve it with Caddy, which also proxies /api
# to the API container and gets HTTPS certificates on its own. See docs/DEPLOY.md.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_DONATE_URL=""
ARG VITE_SOURCE_URL=""
ENV VITE_DONATE_URL=$VITE_DONATE_URL VITE_SOURCE_URL=$VITE_SOURCE_URL
RUN npm run build

FROM caddy:2.8-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
