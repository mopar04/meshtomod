# MeshToMod production site. MESHTOMOD_DOMAIN is the site (meshtomod.com); the redirect
# domains (meshtomodel.com, www.*) send visitors there. Caddy gets and renews the HTTPS
# certificates itself, so ports 80 and 443 must reach this container.

{$MESHTOMOD_REDIRECT_DOMAINS:www.localhost} {
	redir https://{$MESHTOMOD_DOMAIN:localhost}{uri} permanent
}

{$MESHTOMOD_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		# Two scans of up to 200 MB plus form fields. The API checks each file too, but
		# only after the whole body is on disk, so this is the real cap.
		request_body {
			max_size 420MB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
