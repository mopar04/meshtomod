# Copy to .env on the server (never commit .env). Used by docker-compose.prod.yml.
MESHTOMOD_DOMAIN=meshtomod.com
# Comma-separated; each redirects to MESHTOMOD_DOMAIN.
MESHTOMOD_REDIRECT_DOMAINS=www.meshtomod.com, meshtomodel.com, www.meshtomodel.com
VITE_DONATE_URL=
VITE_SOURCE_URL=https://github.com/mopar04/meshtomod
# Sizing for an 8 GB server: one conversion at a time, up to 7 GB for the API.
MESHTOMOD_API_MEMORY=7g
MESHTOMOD_MAX_RUNNING_JOBS=1
MESHTOMOD_MAX_QUEUED_JOBS=4
MESHTOMOD_MAX_FACES=2500000
MESHTOMOD_JOB_TIMEOUT_S=900
MESHTOMOD_JOBS_PER_CLIENT_HOUR=20
MESHTOMOD_RESULT_TTL_MIN=60
